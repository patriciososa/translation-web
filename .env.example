# Shared secret used to sign customer session JWTs.
# Must match JWT_SECRET in api/.env. Required in production.
JWT_SECRET=dev-only-jwt-secret

# URL of the chat backend (Socket.IO server).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Company name shown across the website and the quote assistant.
NEXT_PUBLIC_COMPANY_NAME=Bluelab

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Unset disables analytics.
#NEXT_PUBLIC_GA_MEASUREMENT_ID=
